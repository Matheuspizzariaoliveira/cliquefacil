rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function ownsClient(clientId){return signedIn() && get(/databases/$(database)/documents/clients/$(clientId)).data.ownerId == request.auth.uid;}
  function managesClient(clientId){return signedIn() && get(/databases/$(database)/documents/clientAccess/$(request.auth.uid)).data.clientId == clientId;}
  function canManageCatalog(clientId){return ownsClient(clientId) || managesClient(clientId);}
  match /clientAccess/{uid} {
   allow read: if signedIn() && request.auth.uid == uid;
   allow create: if signedIn() && request.resource.data.clientId is string && ownsClient(request.resource.data.clientId);
   allow update: if signedIn() && ownsClient(resource.data.clientId) && request.resource.data.clientId == resource.data.clientId;
   allow delete: if signedIn() && ownsClient(resource.data.clientId);
  }
  match /clients/{clientId} {
   allow read: if resource.data.active == true || ownsClient(clientId) || managesClient(clientId);
   allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
   allow update: if (ownsClient(clientId) && request.resource.data.ownerId == resource.data.ownerId) || (managesClient(clientId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','description','phone','instagram','address','hours','welcomeText','accent','layout','buttonText','template','logoUrl','coverUrl','updatedAt']));
   allow delete: if ownsClient(clientId);
   match /items/{itemId} {
    allow read: if get(/databases/$(database)/documents/clients/$(clientId)).data.active == true || canManageCatalog(clientId);
    allow create, update, delete: if canManageCatalog(clientId);
   }
   match /orders/{orderId} {
    allow create: if get(/databases/$(database)/documents/clients/$(clientId)).data.active == true;
    allow read, update, delete: if ownsClient(clientId);
   }
   match /appointments/{appointmentId} {
    allow create: if get(/databases/$(database)/documents/clients/$(clientId)).data.active == true;
    allow read, update, delete: if ownsClient(clientId);
   }
   match /slots/{slotId} {
    allow read, create: if get(/databases/$(database)/documents/clients/$(clientId)).data.active == true;
    allow update, delete: if ownsClient(clientId);
   }
  }
 }
}